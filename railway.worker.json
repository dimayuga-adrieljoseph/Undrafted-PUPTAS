{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "puptas/Dockerfile",
    "dockerBuildContext": "puptas",
    "watchPatterns": ["**"]
  },
  "deploy": {
    "startCommand": "php artisan queue:work --queue=high,emails,default --tries=3 --sleep=3 --max-time=3600",
    "restartPolicyType": "ALWAYS"
  }
}
