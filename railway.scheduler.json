{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "puptas/Dockerfile",
    "dockerBuildContext": "puptas",
    "watchPatterns": ["**"]
  },
  "deploy": {
    "startCommand": "php artisan schedule:work",
    "restartPolicyType": "ALWAYS"
  }
}
