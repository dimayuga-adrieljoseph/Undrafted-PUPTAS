# =============================================================================
# PUPTAS — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#   cp .env.example .env
#
# NEVER commit your actual .env file to version control.
# =============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME="PUPTAS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
INSTALLATION_ENV=local

# ----------------------------------------------------------------------------
# Frontend / Vite
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8000
VITE_APP_NAME=""
VITE_APP_ENV=""
NODE_ENV=development

# ----------------------------------------------------------------------------
# Database (MySQL)
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=puptas
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------------------------------------------
# Cache & Session
# ----------------------------------------------------------------------------
CACHE_STORE=array
CACHE_PREFIX=
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=localhost
SESSION_PATH=/
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ----------------------------------------------------------------------------
# Redis (optional -- required if CACHE_STORE=redis or QUEUE_CONNECTION=redis)
# ----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ----------------------------------------------------------------------------
# Mail (Resend)
# ----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=admissions@example.com
MAIL_FROM_NAME="PUP Taguig Admissions"
MAIL_REPLY_TO_ADDRESS=taguig@pup.edu.ph
MAIL_REPLY_TO_NAME="PUP Taguig Admission and Registration Office"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
BROADCAST_CONNECTION=log

# ----------------------------------------------------------------------------
# File Storage (AWS S3 / Railway Object Storage)
# ----------------------------------------------------------------------------
FILESYSTEM_DISK=local
ACTIVE_STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ----------------------------------------------------------------------------
# Laravel Passport (OAuth2 -- generate via: php artisan passport:keys)
# ----------------------------------------------------------------------------
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# ----------------------------------------------------------------------------
# Identity Provider (IDP) -- External SSO
# ----------------------------------------------------------------------------
IDP_BASE_URL=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_REDIRECT_URI=http://localhost:8000/auth/callback
IDP_SCOPE="openid profile email"
IDP_ALLOWED_IPS=

# ----------------------------------------------------------------------------
# AI / LLM Integrations
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
DOCLING_URL=
DOCLING_API_KEY=
DOCLING_TIMEOUT=60

# ----------------------------------------------------------------------------
# Chatwoot (Live Chat Integration)
# ----------------------------------------------------------------------------
CHATWOOT_BASE_URL=
CHATWOOT_ACCESS_TOKEN=
CHATWOOT_WEBSITE_TOKEN=
CHATWOOT_HMAC_TOKEN=
CHATWOOT_SECRET_KEY=

# ----------------------------------------------------------------------------
# Medical Webhook
# ----------------------------------------------------------------------------
MEDICAL_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# PostgreSQL / PgVector (optional -- for vector search features)
# ----------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# ----------------------------------------------------------------------------
# Misc / PHP / Server
# ----------------------------------------------------------------------------
BCRYPT_ROUNDS=12
PHP_CLI_SERVER_WORKERS=4
PORT=8000
FORCE_SSL=false
DATABASE_SSL_VERIFY=false
MEMCACHED_HOST=127.0.0.1
SECRET_KEY_BASE=
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
CACHEBUST=1
