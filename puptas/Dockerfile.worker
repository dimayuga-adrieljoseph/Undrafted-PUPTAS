# =============================================================================
# Stage 1: PHP Dependencies
# =============================================================================
FROM php:8.4-cli AS php-dependencies

RUN apt-get update && apt-get install -y \
    git curl \
    libzip-dev libonig-dev libxml2-dev \
    libfreetype6-dev libjpeg62-turbo-dev libpng-dev libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install \
        pdo pdo_mysql zip mbstring exif pcntl bcmath gd

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY . .

RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

# =============================================================================
# Stage 2: Worker Image (PHP CLI — no Apache, no frontend build)
# =============================================================================
FROM php:8.4-cli

RUN apt-get update && apt-get install -y \
    libzip-dev libonig-dev libxml2-dev \
    libfreetype6-dev libjpeg62-turbo-dev libpng-dev libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install \
        pdo pdo_mysql zip mbstring exif pcntl bcmath gd

RUN echo "memory_limit=256M" > /usr/local/etc/php/conf.d/memory.ini

RUN echo "upload_max_filesize=10M\n\
post_max_size=12M\n\
max_execution_time=300\n\
max_input_time=300" > /usr/local/etc/php/conf.d/uploads.ini

WORKDIR /var/www/html

COPY --from=php-dependencies /app /var/www/html

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create all runtime directories at build time
RUN mkdir -p storage/framework/{sessions,views,cache,maintenance} \
             storage/logs \
             storage/app/public/uploads/files \
             storage/app/templates \
             bootstrap/cache \
    && cp docs/SAR-FORM_TEMPLATE-2.pdf storage/app/templates/ \
    && chmod -R 775 storage bootstrap/cache \
    && chmod -R 755 storage/framework storage/logs

ENV SERVICE_ROLE=worker

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["php", "artisan", "queue:work", "--queue=high,emails,default", "--tries=3", "--sleep=3", "--max-time=3600"]
